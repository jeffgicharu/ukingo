[Unit]
Description=Ukingo background jobs
After=network.target postgresql.service
ConditionPathExists=/var/www/ukingo.jeffgicharu.com/current/tools/jobs.mjs

[Service]
User=ukingo
Group=ukingo
WorkingDirectory=/var/www/ukingo.jeffgicharu.com/current
EnvironmentFile=/var/www/ukingo.jeffgicharu.com/shared/env
Environment=NODE_ENV=production
Environment=DATABASE_POOL=3
Environment=DATABASE_APP_NAME=ukingo-jobs
ExecStart=/var/www/ukingo.jeffgicharu.com/runtime/node/bin/node --max-old-space-size=220 tools/jobs.mjs
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
# Node ends with 143 when it is asked to stop. That is a clean stop, not a failure.
SuccessExitStatus=143
TimeoutStopSec=30
MemoryMax=300M
MemorySwapMax=0
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
