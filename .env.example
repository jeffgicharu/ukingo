# Copy to .env.local for development. On the server these live in one file
# outside the releases, readable only by the application's user.

# The public address of the site, without a trailing slash.
SITE_URL=http://127.0.0.1:3000

# PostgreSQL 16 or newer. The database needs the btree_gist extension.
DATABASE_URL=postgres://ukingo:password@127.0.0.1:5432/ukingo

# A database the tests may empty and rebuild. Its name must contain "test".
DATABASE_URL_TEST=postgres://ukingo:password@127.0.0.1:5432/ukingo_test

# Signs the private link of every booking. At least 32 random characters:
#   openssl rand -hex 32
APP_SECRET=

# Search engines are asked not to list the site unless this is "true".
ALLOW_INDEXING=false

# M-Pesa, through Safaricom's Daraja API. Leave these out and the site offers
# no M-Pesa payment. DARAJA_ENV is "sandbox" or "production".
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=

# When set, every prompt asks for this many shillings whatever is owed, and
# the payment page says so. For use with Safaricom's test system.
MPESA_PROMPT_SHILLINGS=

# "true" lets a booking be completed with a payment that moves no money.
TEST_PAYMENTS=false

# Email, through Resend. Without a key, messages are written and kept but not sent.
RESEND_API_KEY=
MAIL_FROM="Ukingo <ukingo@example.com>"
MAIL_DAILY_LIMIT=40
MAIL_ADDRESS_LIMIT=8
MAIL_VISITOR_LIMIT=10

# The folder the nightly backup writes to (see deploy/backup.sh). When set,
# the background jobs check each morning that last night's backup was made
# and that it restored.
BACKUP_DIR=

# Where errors and failed jobs are reported.
ALERT_EMAIL=

# The folder that keeps photographs staff put up from the back office. Keep
# it outside the release, so photographs outlive it. Left empty, a development
# copy uses uploads/ in the project.
MEDIA_DIR=

# "true" makes this a lodge kept for training. Two training accounts are
# offered, every booking is thrown away each night and the books are written
# again around the day's date. Never set this where real guests book.
TRAINING_MODE=false

# What a link must carry to open a training account without a password:
# /desk/try/reservations?key=…, /desk/try/front-desk?key=… and, to open a
# sample booking as its guest, /try/booking?key=…. At least 16 characters.
TRAINING_KEY=
